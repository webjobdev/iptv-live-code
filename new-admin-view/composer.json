{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.3",
        "barryvdh/laravel-dompdf": "^2.2",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "2.7",
        "jenssegers/mongodb": "^3.8",
        "laravel/framework": "^8.0",
        "laravel/socialite": "5.2",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^3.4",
        "maatwebsite/excel": "3.1.31",
        "razorpay/razorpay": "^2.9",
        "spatie/laravel-analytics": "*",
        "tymon/jwt-auth": "*"
    },
    "require-dev": {
        "facade/ignition": "^2.3.6",
        "fzaninotto/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "classmap": [
            "database",
            "packages/contus/user/src/database/migrations"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Contus\\Base\\": "packages/contus/base/src",
            "Contus\\User\\": "packages/contus/user/src",
            "Contus\\Cms\\": "packages/contus/cms/src",
            "Contus\\Video\\": "packages/contus/video/src",
            "Contus\\Audio\\": "packages/contus/audio/src",
            "Contus\\Playlist\\": "packages/contus/playlist/src",
            "Contus\\Customer\\": "packages/contus/customer/src",
            "Contus\\Payment\\": "packages/contus/payment/src",
            "Contus\\Notification\\": "packages/contus/notification/src",
            "Contus\\Geofencing\\": "packages/contus/geofencing/src",
            "Contus\\Organizations\\": "packages/contus/organizations/src/",
            "Contus\\Drm\\": "packages/contus/drm/src/",
            "Contus\\Subscribers\\": "packages/contus/subscribers/src/",
            "Contus\\Settings\\": "packages/contus/settings/src/",
            "Contus\\ApiAccess\\": "packages/contus/api-access/src/",
            "Contus\\Vod\\": "packages/contus/vod/src/",
            "Contus\\StreamServices\\": "packages/contus/stream-services/src/",
            "Contus\\Tvshow\\": "packages/contus/tvshow/src/",
            "Contus\\Channel\\": "packages/contus/channel/src/",
            "Contus\\ChannelServices\\": "packages/contus/channel-services/src/",
            "Contus\\PartnerProgram\\": "packages/contus/partner-programs/src/",
            "Contus\\PermissionRule\\": "packages/contus/permission-rules/src/",
            "Contus\\Reports\\": "packages/contus/reports/src/",
            "Contus\\Devices\\": "packages/contus/devices/src/",
            "Contus\\GeoBlocking\\": "packages/contus/geo-blocking/src/",
            "Contus\\SystemUser\\": "packages/contus/system-users/src/"

        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
